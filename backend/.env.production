# 服务器配置
PORT=5000
NODE_ENV=production

# MongoDB Atlas 连接URI（请按照以下说明配置）
# 1. 访问 https://www.mongodb.com/atlas 注册账号
# 2. 创建免费集群
# 3. 创建数据库用户（用户名和密码）
# 4. 配置网络访问（允许从任何IP访问或指定您的服务器IP）
# 5. 复制连接字符串并替换以下占位符
MONGO_URI=mongodb://localhost:27017/portfolio_db

# 强JWT密钥（生产环境）
JWT_SECRET=portfolio_production_secure_jwt_secret_key_please_change_this

# 允许的前端域名（生产环境）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-github-username.github.io

# 其他生产环境配置
SERVER_HOST=0.0.0.0

# 日志级别
LOG_LEVEL=info